<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.stalwart.identity.provisioning</groupId>
    <artifactId>identity-outbound-provisioning-stalwart-scim</artifactId>
    <version>2.0.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>org.stalwart.identity.provisioning.connector.scim</artifactId>
  <name>Stalwart SCIM Provisioning Connector</name>
  <packaging>jar</packaging>

  <dependencies>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.11.0</version></dependency>
    <dependency><groupId>commons-lang.wso2</groupId><artifactId>commons-lang</artifactId></dependency>
    <dependency><groupId>org.wso2.carbon</groupId><artifactId>org.wso2.carbon.user.core</artifactId></dependency>
    <dependency><groupId>org.wso2.carbon</groupId><artifactId>org.wso2.carbon.core</artifactId></dependency>
    <dependency><groupId>org.wso2.carbon</groupId><artifactId>org.wso2.carbon.utils</artifactId></dependency>
    <dependency><groupId>org.wso2.charon</groupId><artifactId>org.wso2.charon.core</artifactId></dependency>
    <dependency><groupId>org.wso2.carbon.identity.inbound.provisioning.scim</groupId><artifactId>org.wso2.carbon.identity.scim.common</artifactId></dependency>
    <dependency><groupId>org.wso2.carbon.identity.framework</groupId><artifactId>org.wso2.carbon.identity.core</artifactId></dependency>
    <dependency><groupId>org.wso2.carbon.identity.framework</groupId><artifactId>org.wso2.carbon.identity.provisioning</artifactId></dependency>
    <dependency><groupId>org.wso2.carbon.identity.framework</groupId><artifactId>org.wso2.carbon.identity.application.common</artifactId></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.core</artifactId><version>6.0.0</version><scope>provided</scope></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.service.component</artifactId><version>1.5.1</version><scope>provided</scope></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.service.component.annotations</artifactId><version>1.5.1</version><scope>provided</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration><release>21</release></configuration>
      </plugin>

      <!-- Keep Gson as a nested bundle entry, preserving the 1.0.7 runtime model. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-embedded-gson</id>
            <phase>process-resources</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeArtifactIds>gson</includeArtifactIds>
              <outputDirectory>${project.build.outputDirectory}/lib</outputDirectory>
              <stripVersion>false</stripVersion>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <version>${bnd.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>generate-osgi-metadata-and-ds</id>
            <phase>process-classes</phase>
            <goals><goal>bnd-process</goal></goals>
          </execution>
        </executions>
        <configuration>
          <bnd><![CDATA[
Bundle-SymbolicName: org.stalwart.identity.provisioning.connector.scim
Bundle-Version: ${project.version}
Bundle-Name: Stalwart SCIM Provisioning Connector
Bundle-ActivationPolicy: lazy
Bundle-StartLevel: 1
Bundle-ClassPath: .,lib/gson-2.11.0.jar
-dsannotations: *
-dsannotations-options: inherit
Export-Package: !org.stalwart.identity.provisioning.connector.scim.internal,org.stalwart.identity.provisioning.connector.scim.*;version="${project.version}"
Import-Package: org.wso2.carbon.identity.provisioning;version="[7.10,8)",org.wso2.carbon.identity.application.common.model;version="[7.10,8)",!com.google.gson.* ,*
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=21))"
          ]]></bnd>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>factory-smoke-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.stalwart.identity.provisioning.connector.scim.StalwartSCIMFactorySmokeTest</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
