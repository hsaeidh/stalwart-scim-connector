<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.stalwart.identity.provisioning</groupId>
    <artifactId>identity-outbound-provisioning-stalwart-scim</artifactId>
    <version>2.0.3-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>org.stalwart.identity.provisioning.event.handler</artifactId>
  <name>Stalwart SCIM WSO2 Profile Event Observer</name>
  <packaging>jar</packaging>
  <dependencies>
    <dependency>
      <groupId>org.wso2.carbon.identity.framework</groupId>
      <artifactId>org.wso2.carbon.identity.event</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.stalwart.identity.provisioning</groupId>
      <artifactId>org.stalwart.identity.provisioning.connector.scim</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.wso2.carbon.identity.framework</groupId>
      <artifactId>org.wso2.carbon.identity.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.wso2.carbon</groupId>
      <artifactId>org.wso2.carbon.user.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.core</artifactId>
      <version>6.0.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <version>1.5.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <version>1.5.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration><release>21</release></configuration>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <version>${bnd.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>generate-osgi-metadata-and-ds</id>
            <phase>process-classes</phase>
            <goals><goal>bnd-process</goal></goals>
          </execution>
        </executions>
        <configuration>
          <bnd><![CDATA[
Bundle-SymbolicName: org.stalwart.identity.provisioning.event.handler
Bundle-Version: ${project.version}
Bundle-Name: Stalwart SCIM WSO2 Profile Event Observer
Bundle-ActivationPolicy: lazy
-dsannotations: *
-dsannotations-options: inherit
Import-Package: org.stalwart.identity.provisioning.connector.scim;version="[2.0.3,3)",org.wso2.carbon.user.core;version="[4,6)",org.wso2.carbon.identity.event;version="[7.10,8)",org.wso2.carbon.identity.event.event;version="[7.10,8)",org.wso2.carbon.identity.event.handler;version="[7.10,8)",org.wso2.carbon.identity.core.bean.context;version="[7.10,8)",*
          ]]></bnd>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
